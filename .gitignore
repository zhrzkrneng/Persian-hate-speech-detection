# Datasets are never committed. HMC is redistributed under a click-through
# licence, and the Persian memes carry third-party image rights.
# Anchored with a leading slash so src/data/ is not swept up with it.
/data/
*.rar
*.zip

# Cached encoder features
/features/
*.npy
*.pt

# Run artefacts. Measured results are kept: they are this project's own
# numbers, a few hundred bytes each, and a paper's claim should be traceable
# to the file that produced it. Only the heavy, regenerable artefacts are
# ignored.
/runs/**
# Directories must be re-included at every depth, or git never descends far
# enough for the *.json rule to apply. runs/retrieval/x.json worked with only
# one level un-ignored; runs/hmc/<arch>/<fusion>/seed0.json did not.
!/runs/**/
!/runs/**/*.json
checkpoints/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
paper/node_modules/
paper/page-*.jpg
paper/*.pdf
